#!/usr/bin/env bash
# Стаб flock. Настоящая блокировка стенду не нужна — важны только путь кода и код возврата
# (реальный flock работает с дескриптором, который открыл сам скрипт, стаб этого повторить и
# не может).
#
# Без этого стаба на macOS, где flock отсутствует вовсе, acquire_switch_lock уходит в ветку
# «flock не найден» и НИ ОДИН сценарий не проверяет ни создание файла лока, ни занятость —
# при том что на ubuntu в CI та же ветка не берётся и код исполняется. Стенд обязан вести себя
# одинаково в обоих местах.
#
# STUB_FLOCK_BUSY=1 — лок уже держит другой процесс.
echo "flock $*" >> "$STUB_LOG"
[ "${STUB_FLOCK_BUSY:-0}" = "1" ] && exit 1
exit 0
